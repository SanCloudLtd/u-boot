/dts-v1/;

/ {
    description = "Beaglebone black";
    #address-cells = <1>;
    images {
        kernel {
            description = "vmlinuz-5.10.168-ti-r79";
            data = /incbin/("./vmlinuz-5.10.168-ti-r79");
            type = "kernel";
            arch = "arm";
            os = "linux";
            load =  <0x89000000>;
            entry = <0x89000000>;
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };
        };
        fdt-ligth {
            description = "am335x-sancloud-bbe-lite.dtb";
            data = /incbin/("./am335x-sancloud-bbe-lite.dtb");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88000000>;
            hash-1 {
                algo = "sha256";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };
        };
        fdt-ADC {
            description = "BB-ADC-00A0.dtbo";
            data = /incbin/("./BB-ADC-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88f00000>;
            hash-1 {
                algo = "sha256";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };
        };
        fdt-eMMC1 {
            description = "BB-BONE-eMMC1-01-00A0.dtbo";
            data = /incbin/("./BB-BONE-eMMC1-01-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88f00000>;
            hash-1 {
                algo = "sha256";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };
        };
        fdt-SPI {
            description = "BB-SPIDEV0-00A0.dtbo";
            data = /incbin/("./BB-SPIDEV0-00A0.dtbo");
            type = "flat_dt";
            os = "linux";
            arch = "arm";
            compression = "none";
            load =<0x88f00000>;
            hash-1 {
                algo = "sha256";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };

        };
        initrd {
            description = "Initrd";
            data = /incbin/("./initrd.img-5.10.168-ti-r79");
            type = "ramdisk";
            arch = "arm";
            os = "linux";
            load =<0x88080000>;
            entry=<0x88080000>;
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };

        };
    };
    configurations {
        default = "r79";
        r79 {
            description = "";
            kernel = "kernel";
            fdt = "fdt-ligth","fdt-ADC","fdt-SPI","fdt-eMMC1";
            #ramdisk = "initrd";
            signature-1 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
                sign-images = "fdt", "kernel";
            };
        };
    };
};