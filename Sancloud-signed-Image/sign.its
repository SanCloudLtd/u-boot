/dts-v1/;

/ {
    description = "Beaglebone black";
    #address-cells = <1>;
    images {
        kernel {
            data = /incbin/("./vmlinuz-5.10.168-ti-r79");
            type = "kernel";
            arch = "arm";
            os = "linux";
            load =  <0x82000000>;
            entry = <0x82000000>;
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
        };
        fdt-ligth {
            description = "am335x-sancloud-bbe-lite-uboot.dtb";
            data = /incbin/("./am335x-sancloud-bbe-lite-uboot.dtb");
            type = "flat_dt";
            arch = "arm";
            load=<0x88000000>;
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
        };
        fdt-ADC {
            description = "BB-ADC-00A0.dtbo";
            data = /incbin/("./BB-ADC-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            load=<0x60000>;
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
        };
        fdt-eMMC1 {
            description = "BB-BONE-eMMC1-01-00A0.dtbo";
            data = /incbin/("./BB-BONE-eMMC1-01-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
        };
        fdt-SPI {
            description = "BB-SPIDEV0-00A0.dtbo";
            data = /incbin/("./BB-SPIDEV0-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
        };
        initrd {
            description = "Initrd";
            data = /incbin/("./initrd.img-5.10.168-ti-r79");
            type = "ramdisk";
            arch = "arm";
            os = "linux";
            load =<0x88080000>;
            entry=<0x88080000>;
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
        };
    };
    configurations {
        default = "conf-1";
        conf-1 {
            description = "load Image and FDT";
            kernel = "kernel";
            fdt = "fdt-ligth","fdt-ADC";
            ramdisk = "initrd";
            signature-1 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
                sign-images = "fdt", "kernel","initrd";
            };
        };  
        eMMC1 {
            description = "eMMC1 Overlay";
            fdt = "fdt-eMMC1";
            signature-1 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
                sign-images = "fdt", "kernel","initrd";
            };
         };
        SPI {
            description = "SPI Overlay";
            fdt = "fdt-SPI";
            signature-1 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
                sign-images = "fdt", "kernel","initrd";
            };
         };    
    };
};