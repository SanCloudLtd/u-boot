/dts-v1/;

/ {
    description = "Beaglebone black";
    #address-cells = <1>;
    images {
        kernel {
            description = "vmlinuz-5.10.168-ti-r79";
            data = /incbin/("./vmlinuz-5.10.168-ti-r79");
            type = "kernel";
            arch = "arm";
            os = "linux";
            load =  <0x89000000>;
            entry = <0x89000000>;
            compression = "none";
        };
        main_fdt {
            description = "am335x-sancloud-bbe-lite.dtb";
            data = /incbin/("./am335x-sancloud-bbe-lite.dtb");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88000000>;
        };
        fdt-ADC {
            description = "BB-ADC-00A0.dtbo";
            data = /incbin/("./BB-ADC-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88f00000>;
        };
        fdt-eMMC1 {
            description = "BB-BONE-eMMC1-01-00A0.dtbo";
            data = /incbin/("./BB-BONE-eMMC1-01-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88f00000>;
        };
        fdt-SPI {
            description = "BB-SPIDEV0-00A0.dtbo";
            data = /incbin/("./BB-SPIDEV0-00A0.dtbo");
            type = "flat_dt";
            os = "linux";
            arch = "arm";
            compression = "none";
            load =<0x88f00000>;
        };
        initrd {
            description = "Initrd";
            data = /incbin/("./initrd.img-5.10.168-ti-r79");
            type = "ramdisk";
            arch = "arm";
            os = "linux";
            load =<0x88080000>;
            entry=<0x88080000>;
            compression = "none";

        };
    };
    configurations {
        default = "KERNEL_ONLY";
        KERNEL_ONLY{
            description = "LOAD DEBEIAN KERNEL";
            kernel = "kernel";
            fdt = "main_fdt";
            #ramdisk = "initrd";
        };
        ADC {
            description = "ADC support FDT";
            fdt ="fdt-ADC";
        };
        SPI {
            description = "SPI support FDT";
            fdt ="fdt-SPI";
        };
        eMMC1 {
            description = "eMMC1 support FDT";
            fdt ="fdt-eMMC1";
        };
     
    };
};