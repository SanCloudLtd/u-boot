/dts-v1/;

/ {
    description = "Beaglebone black";
    #address-cells = <1>;
    images {
        kernel {
            description = "vmlinuz-5.10.168-ti-r79";
            data = /incbin/("./vmlinuz-5.10.168-ti-r79");
            type = "kernel";
            arch = "arm";
            os = "linux";
            load =  <0x89000000>;
            entry = <0x89000000>;
            compression = "none";
        };
        args {
            description = "FALCON BOOT ARGS";
            data = /incbin/("./falconargs");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x8f81f000>;
            entry = <0x8f81f000>;
        };
    };
    configurations {
        default = "SanCloud-None-Secure";
        SanCloud-None-Secure {
            description = "";
            kernel = "kernel";
            fdt = "args";
        };
    };
};