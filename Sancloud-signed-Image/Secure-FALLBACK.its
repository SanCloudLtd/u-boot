/dts-v1/;

/ {
    description = "Beaglebone black";
    #address-cells = <1>;
    images {
        kernel {
            description = "vmlinuz-@VERSION@";
            data = /incbin/("./vmlinuz-@VERSION@");
            type = "kernel";
            arch = "arm";
            os = "linux";
            load =  <0x89000000>;
            entry = <0x89000000>;
            compression = "none";
            hash{
                algo = "sha256";
            };
        };

        main_fdt {
            description = "am335x-sancloud-bbe-lite.dtb";
            data = /incbin/("./am335x-sancloud-bbe-lite.dtb");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88000000>;
            hash{
                algo = "sha256";
            };
        };
        fdt-ADC {
            description = "BB-ADC-00A0.dtbo";
            data = /incbin/("./BB-ADC-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88f00000>;
            hash{
                algo = "sha256";
            };
        };
        fdt-eMMC1 {
            description = "BB-BONE-eMMC1-01-00A0.dtbo";
            data = /incbin/("./BB-BONE-eMMC1-01-00A0.dtbo");
            type = "flat_dt";
            arch = "arm";
            os = "linux";
            compression = "none";
            load =<0x88f00000>;
            hash{
                algo = "sha256";
            };
        };
        fdt-SPI {
            description = "BB-SPIDEV0-00A0.dtbo";
            data = /incbin/("./BB-SPIDEV0-00A0.dtbo");
            type = "flat_dt";
            os = "linux";
            arch = "arm";
            compression = "none";
            load =<0x88f00000>;
            hash{
                algo = "sha256";
            };
        };
        initrd {
            description = "Initrd";
            data = /incbin/("./initrd.img-@VERSION@");
            type = "ramdisk";
            arch = "arm";
            os = "linux";
            load =<0x88080000>;
            entry=<0x88080000>;
            compression = "none";
            hash{
                algo = "sha256";
            };
        };
    };
    configurations {
        default = "BOOT";
        BOOT{
            description = "BOOT Normal";
            kernel = "kernel";
            fdt = "main_fdt","fdt-ADC","fdt-SPI","fdt-eMMC1";
            ramdisk = "initrd";
            signature{
                algo = "sha256,rsa2048";
                key-name-hint = "conf";
                sign-images = "fdt","ramdisk";
            };

        };
    };
};